# Copy to ~/.config/warp-android-scribe/bridge.env and chmod 600.
# Generate the token with: openssl rand -hex 32
WARP_SCRIBE_ADDR=0.0.0.0:8787
WARP_SCRIBE_TOKEN=replace-with-openssl-rand-hex-32
WARP_SCRIBE_TRANSCRIBER=superwhisper-cli
WARP_SCRIBE_SUPERWHISPER_BIN=superwhisper
WARP_SCRIBE_TIMEOUT_SECS=60
# `tr` (fixed Turkish) or `auto`, and the default when a request has no ?lang.
WARP_SCRIBE_LANGUAGE=tr
